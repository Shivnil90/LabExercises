let book = {
    title: "The Hobbit",
    description: "A fantasy novel about a hobbit's adventure.",
    author: "J.R.R. Tolkien",
    pages: 310
};

// Print individual properties
console.log(book.title);
console.log(book.description);
console.log(book.author);
console.log(book.pages);

